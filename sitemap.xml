    border-radius: 12px;
    padding: 24px 28px;
    margin-bottom: 20px;
  }
  .section h2 {
    margin-top: 0;
    font-size: 1.2rem;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
  }
  li {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  li:last-child { border-bottom: none; }
  a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }
  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .desc {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 2px;
  }
  .badge {
