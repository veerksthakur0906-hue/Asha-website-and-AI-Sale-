    background: rgba(109,140,255,0.15);
    color: var(--accent);
    padding: 2px 8px;
    border-radius: 20px;
    margin-left: 8px;
  }
  footer {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 40px;
  }
